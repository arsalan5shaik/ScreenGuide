# ============================================================
# ScreenGuide for Windows — API Keys (all optional, auto-detected)
# ============================================================
# Copy this file to .env and fill in the keys you have.
# ScreenGuide auto-detects what's available and uses the best one.
# If no keys are set, it falls back to Ollama (free, local).

# ── LLM Providers (priority: Claude > OpenAI > Gemini > Ollama) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Any OpenAI-compatible server works via the OpenAI provider — set the base
# URL + a default model, put the provider's key in OPENAI_API_KEY. Examples:
#   DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com   OPENAI_DEFAULT_MODEL=deepseek-chat
#   DashScope:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=

# ── Speech-to-Text ───────────────────────────────────────────
# Leave empty to use faster-whisper (free, local, runs on CPU)
DEEPGRAM_API_KEY=
# OPENAI_API_KEY also enables OpenAI Whisper if set above

# ── Text-to-Speech ───────────────────────────────────────────
# Leave empty to use edge-tts (free, no key, Microsoft neural)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Web Search (for grounding LLM with live info) ────────────
# Leave empty to use DuckDuckGo (free, no key)
TAVILY_API_KEY=

# ── Ollama Settings ──────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Legacy single-model knob (used as fallback if the two below are empty)
OLLAMA_MODEL=llama3.2-vision
# Per-task model selection — vision = screen-aware, text = Code Mode / journal Q&A.
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TEXT_MODEL=qwen2.5vl:7b

# ── LM Studio Settings ───────────────────────────────────────
# Alternative to Ollama. Start LM Studio → Developer tab → Start Server,
# load a model, then select "lmstudio" from Tray → Model. No key needed.
LMSTUDIO_HOST=http://localhost:1234/v1
# Leave empty to use whatever model is currently loaded in LM Studio.
LMSTUDIO_MODEL=

# ── App Settings ─────────────────────────────────────────────
# Push-to-talk hotkey. Modifier-only combos (ctrl+win) are held down; combos
# ending in a normal key (ctrl+alt+space) are held with the last key tapped.
SCREENGUIDE_HOTKEY=ctrl+win
# Whisper model size: tiny, base, small, medium (larger = slower but more accurate)
WHISPER_MODEL=base

# Which LLM to use on startup: claude, openai, gemini, ollama, lmstudio
# Leave empty to auto-detect from whichever API keys are set above.
SCREENGUIDE_ACTIVE_LLM=

# ── Rolling screen history ───────────────────────────────────
# ScreenGuide saves a screenshot on a timer so it can see what CHANGED, not
# just what's on screen now. Images stay on this machine, are never uploaded,
# and are deleted once they pass the age limit below.
# All of this is editable from Tray → Settings → Screen capture.
SCREENSHOT_HISTORY=1
# Seconds between automatic captures.
SCREENSHOT_INTERVAL_S=60
# Delete captures older than this many minutes.
SCREENSHOT_RETENTION_MIN=60
# Total images sent with each question; the newest is always the live screen,
# the rest are recent history. Each extra image costs real time on a local
# model — set to 1 if replies feel slow.
SCREENSHOT_SEND_COUNT=1
# Longest edge of a stored capture. Lower = faster model, less readable text.
SCREENSHOT_MAX_WIDTH=1280
# Where captures are written. Empty = %LOCALAPPDATA%\ScreenGuide\screenshots
SCREENSHOT_DIR=
# How long to wait for a local model before giving up, in seconds.
OLLAMA_TIMEOUT_S=900

# ── Highlighted text ─────────────────────────────────────────
# Highlight something on screen, then just ask "what does this mean?" —
# the selection is sent as the subject of the question.
SELECTION_CONTEXT=1
# Apps that expose nothing to UI Automation need a Ctrl+C round-trip to read
# the selection. Your clipboard is restored afterwards, and is left alone
# when it holds an image or files. Set to 0 to never touch the clipboard.
SELECTION_USE_CLIPBOARD=1
