# ScreenGuide sync server — local development config.
# Copy to server/.env and fill in. NEVER commit the filled-in file.
# On Render these same keys go in the service's Environment tab instead.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://cuhdmuwglcyzmchirwki.supabase.co

# Supabase → Project Settings → API Keys → anon / publishable.
# Safe to ship in the desktop app; RLS is what protects the data.
SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → service_role (click Reveal).
# SECRET. Bypasses RLS entirely. Server-side only — never in the desktop
# app, never in git.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
PORT=8000
LOG_LEVEL=info
MAX_SYNC_BATCH=500
TOKEN_CACHE_TTL=60
ALLOWED_ORIGINS=*
